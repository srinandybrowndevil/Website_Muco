__pycache__/
*.pyc

# Secrets. This repository is public, so a committed key is a published key.
# Real values belong in Vercel -> Settings -> Environment Variables.
# .env.example is tracked deliberately: it documents the names, never the values.
.env
.env.*
!.env.example
*.pem
*.key

# Playwright MCP scratch output
.playwright-mcp/
*-mobile.png
page-*.yml
_audit.js

# Raw screen recordings. build_clips.py encodes these into assets/clips/, which
# IS committed -- Vercel serves the generated files and does not run the
# scripts. The sources can run to tens of megabytes each and nothing serves
# them, so they stay out. Keep the originals somewhere you can re-encode from.
/clips/

__pycache__/
*.pyc

# Secrets. This repository is public, so a committed key is a published key.
# Real values belong in Vercel -> Settings -> Environment Variables.
# .env.example is tracked deliberately: it documents the names, never the values.
.env
.env.*
!.env.example
*.pem
*.key

# Playwright MCP scratch output
.playwright-mcp/
*-mobile.png
page-*.yml
_audit.js

# Raw screen recordings. build_clips.py encodes these into assets/clips/, which
# IS committed -- Vercel serves the generated files and does not run the
# scripts. The sources can run to tens of megabytes each and nothing serves
# them, so they stay out. Keep the originals somewhere you can re-encode from.
/clips/
/public-site/
/.qa/

# Source illustrations for the portfolio. Each is ~2 MB and nothing serves
# them: build_project_images.py turns them into assets/projects/, which IS
# committed. Keeping the originals here would add ~13 MB to a public repo
# permanently. PROMPTS.md stays tracked so the provenance is not lost.
/project-images/*.png

# Personal Claude Code permissions, not shared settings. This repository is
# public and the file records one machine's local paths.
.claude/settings.local.json

# Mobile audit output. reports/*.md are written findings and stay tracked;
# reports/mobile/ is regenerated screenshots and measurements from
# scripts/mobile-audit.cjs, which nothing serves and every run rewrites.
/reports/mobile/

# Playwright run output
test-results/
playwright-report/

# Dependencies
node_modules/

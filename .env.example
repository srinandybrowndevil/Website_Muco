# Environment variables for mucolabs.com
#
# Copy nothing from here into the repository. Set these in
# Vercel -> Project -> Settings -> Environment Variables.
#
# The public website is static and does not use a database. The only
# server-side feature is the enquiry email endpoint.

# Resend API key. Create one at https://resend.com -> API Keys.
# This is required for the contact / Start a Project form to send email.
RESEND_API_KEY=

# Where lead notifications are delivered.
CONTACT_RECIPIENT_EMAIL=founder@mucolabs.com

# The From address. Must be on a domain verified in Resend, otherwise Resend
# rejects the send.
CONTACT_FROM_EMAIL=

# Environment variables for mucolabs.com
#
# Copy nothing from here into the repository. Set these in
# Vercel -> Project -> Settings -> Environment Variables.
#
# The site works without any of them: the enquiry endpoint still validates and
# records every lead to the Vercel function log. These only add the email
# notification on top, so a lead is never waiting in a log for someone to
# remember to look.

# Resend API key. Create one at https://resend.com -> API Keys.
RESEND_API_KEY=

# Where enquiry notifications are delivered.
LEAD_TO_EMAIL=founder@mucolabs.com

# The From address. Must be on a domain verified in Resend, otherwise Resend
# rejects the send. Until mucolabs.com is verified there, the endpoint falls
# back to Resend's own onboarding sender.
LEAD_FROM_EMAIL=MUCO LABS <founder@mucolabs.com>

# Environment variables for mucolabs.com
#
# Copy nothing from here into the repository. Set these in
# Vercel -> Project -> Settings -> Environment Variables.
#
# The site works without them. They are only needed for first-party analytics;
# every page renders and every link works whether or not they are set.
#
# The website captures leads through a form that posts to api/lead.js. That
# endpoint records every enquiry to the CRM, and optionally emails it to you as
# well. Without the Resend values a lead is still recorded -- the email is a
# notification on top, not the system of record.

# Supabase public values (optional). Used by api/event.js to record first-party
# analytics into the MUCO CRM. Only the publishable / anon key belongs here --
# never a service role key, which would be readable by anyone.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Resend API key. Create one at https://resend.com -> API Keys. Optional: a
# lead is recorded to the CRM whether or not this is set.
RESEND_API_KEY=

# Where lead notifications are delivered.
LEAD_TO_EMAIL=

# The From address. Must be on a domain verified in Resend, otherwise Resend
# rejects the send.
LEAD_FROM_EMAIL=

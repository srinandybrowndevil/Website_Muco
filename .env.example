# Environment variables for mucolabs.com
#
# Copy nothing from here into the repository. Set these in
# Vercel -> Project -> Settings -> Environment Variables.
#
# The public website is static and does not use a database. The only
# server-side feature is the enquiry email endpoint.

# Resend API key. Create one at https://resend.com -> API Keys.
# This is required for the contact / Start a Project form to send email.
RESEND_API_KEY=

# Where lead notifications are delivered.
CONTACT_RECIPIENT_EMAIL=founder@mucolabs.com

# The From address. Must be on a domain verified in Resend, otherwise Resend
# rejects the send.
CONTACT_FROM_EMAIL=


# ---------------------------------------------------------------------------
# Google Gemini — personalisation for the Website Preview studio
# ---------------------------------------------------------------------------
# Used only by api/preview.js, which runs on the server. The key is never sent
# to the browser, never stored in localStorage, and never appears in any page.
# There is deliberately no NEXT_PUBLIC_ equivalent.
#
# /website-preview works with all of this unset. With no key the endpoint
# answers "fallback" and the studio draws its own deterministic content, so the
# visitor still gets five complete website concepts. Gemini makes the copy
# better; it is not what makes the feature work.
#
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to a current Flash-class model if unset. Kept configurable
# so the model can be changed without editing application code.
GEMINI_MODEL=

# Optional. Milliseconds before the request is abandoned and the deterministic
# content is used instead. Clamped to 1000-60000; defaults to 15000.
GEMINI_TIMEOUT_MS=15000
